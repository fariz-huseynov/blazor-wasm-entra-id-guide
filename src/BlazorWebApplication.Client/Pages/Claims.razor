@page "/claims"
@* Any signed-in user may open this page. *@
@attribute [Authorize]
@using System.Security.Claims

<PageTitle>My claims</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true">My claims</MudText>

<MudText Class="mb-4">
    This is what the app knows about you. It comes from the ID token that Entra ID sent at sign-in.
</MudText>

@if (_user is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">Roles</MudText>
        @if (_roles.Count == 0)
        {
            <MudText Color="Color.Secondary">
                You have no app roles. Assign one in Entra ID, then sign out and sign in again.
            </MudText>
        }
        else
        {
            @foreach (var role in _roles)
            {
                <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.VerifiedUser">@role</MudChip>
            }
        }
        <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
            @foreach (var role in new[] { AppRoles.Reader, AppRoles.Contributor, AppRoles.ApiWriter })
            {
                <MudText Typo="Typo.body2">
                    IsInRole("@role"): <b>@_user.IsInRole(role)</b>
                </MudText>
            }
        </MudStack>
    </MudPaper>

    <MudSimpleTable Dense="true" Striped="true" Elevation="1">
        <thead>
            <tr>
                <th>Type</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in _user.Claims)
            {
                <tr>
                    <td><code>@claim.Type</code></td>
                    <td style="word-break: break-all">@claim.Value</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    // Provided by AddCascadingAuthenticationState (server and client).
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal? _user;
    private List<string> _roles = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null) return;

        _user = (await AuthenticationState).User;
        // The roles are the claims of the identity's role claim type ("roles", set on the server).
        var roleClaimType = (_user.Identity as ClaimsIdentity)?.RoleClaimType ?? AppRoles.ClaimType;
        _roles = [.. _user.FindAll(roleClaimType).Select(c => c.Value)];
    }
}
