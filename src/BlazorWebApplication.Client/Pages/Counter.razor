@page "/counter"

<PageTitle>Counter</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true">Counter</MudText>

<MudText Class="mb-4" role="status">
    Current count: <MudChip T="string" Color="Color.Primary" Size="Size.Small">@currentCount</MudChip>
</MudText>

<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IncrementCount">Click me</MudButton>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
